# Cloudflare Pages response headers
# Translated from the old netlify.toml [[headers]] block, plus caching rules
# for the static assets this site actually serves.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 0

# No caching for JS/CSS either — the site was showing stale config.js on
# visitor devices long after a deploy. no-store forces a fresh fetch so
# every visitor sees the latest build immediately.
/css/*
  Cache-Control: no-cache, no-store, must-revalidate

/js/*
  Cache-Control: no-cache, no-store, must-revalidate

/images/*
  Cache-Control: public, max-age=86400, must-revalidate

# HTML must always be revalidated so page changes appear immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
