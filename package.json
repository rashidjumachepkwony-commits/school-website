{
  "name": "changara-star-academy",
  "version": "3.1.0",
  "description": "Changara Star Academy Management System - Supabase + Cloudflare Worker architecture",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "dev:worker": "cd worker && npx wrangler dev",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "deploy:live": "powershell -ExecutionPolicy Bypass -File scripts/repoint-live.ps1",
    "backup:live": "node scripts/backup-live.mjs",
    "sync:register": "node scripts/sync-student-register.mjs",
    "deploy:pages": "echo \"Deploy the static project through Cloudflare Pages (publish directory = .)\"",
    "deploy:netlify": "npx netlify deploy --dir=. --prod",
    "validate": "node scripts/validate-project.mjs",
    "test:checkin": "node scripts/test-checkin-flows.mjs",
    "test:assessments": "node tests/assessment-calc.test.mjs",
    "test:adapter": "node scripts/test-supabase-adapter.mjs",
    "test:e2e:staff": "node tests/e2e-staff-attendance.mjs"
  },
  "keywords": ["school", "management", "education", "attendance", "student", "teacher", "supabase", "cloudflare"],
  "author": "Changara Star Academy",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
