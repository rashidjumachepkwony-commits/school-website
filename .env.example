# Changara Star Academy - Environment Variables

# Required for production deployment on Cloudflare Pages
# Set JWT_SECRET in the Cloudflare Pages dashboard (Environment Variables)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# Local development (not required for Cloudflare)
# These are NOT used in production - Cloudflare uses secrets/D1 bindings instead
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/schoolDB

# For reference only - these are set via Cloudflare Pages UI, NOT this file
# FRONTEND_URL=https://changarastaracademy.co.ke
# CORS_ORIGIN=*
